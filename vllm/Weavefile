# One open-weights model behind an OpenAI-compatible API, on one GPU box.
#   subweave run vllm "serve Qwen/Qwen3-8B to our app servers on the private network"

ABOUT  "vLLM serving one open-weights model behind an OpenAI-compatible API"
FROM   ubuntu:24.04
NEEDS  8 CPU, 1 GPU, 64 GB RAM, 500 GB DISK
MODEL  CODE deepseek/deepseek-v4-flash-0731 THEN deepseek/deepseek-v4-pro

# ── What a request chooses ─────────────────────────────

ARG model         MUST   "a Hugging Face model id, like Qwen/Qwen3-8B"
ARG access=local  SHOULD
    local     "the API on localhost only"
    private   "the API on the private network, with an API key"
ARG gated=no      MAY
    no        "a public model on Hugging Face"
    yes       "a gated model, which needs a Hugging Face token"

SECRET VLLM_API_KEY "the key that clients send as a bearer token"   IF access == 'private'
SECRET HF_TOKEN     "a Hugging Face token that may download $model"  IF gated == 'yes'

# ── Rules ──────────────────────────────────────────────

NEVER "serve a model other than $model"
NEVER "open port 8000 to the internet"
ASK   BEFORE reboot BECAUSE "a reboot stops the whole box and the model with it"
ASK   BEFORE install-driver BECAUSE "a new GPU driver needs a reboot"
ASK   "before changing the NVIDIA driver or CUDA version"
ASK   "before a vLLM upgrade"

# ── GPU and driver ─────────────────────────────────────

FACT gpu  BOOL   nvidia-smi -L
FACT xid  LINES  journalctl -k -f -n 0 | grep --line-buffered 'NVRM: Xid'

GOAL driver       "the NVIDIA driver sees the GPU"  gpu
GOAL gpu-healthy  "the GPU reported no errors in the last 10 minutes" \
                  AFTER driver  EVERY 5m  OVER 10m  COUNT(xid) == 0

ACTION install-driver "Install the NVIDIA driver" FOR driver WITHIN 20m CHANGES version, restart
  WHEN "the box has a GPU and no NVIDIA driver"
  DO   "install the NVIDIA server driver for compute with ubuntu-drivers, and the matching \
        nvidia-utils server package for nvidia-smi"
  RUN  systemctl reboot

ACTION reboot "Reboot the box" FOR gpu-healthy, running WITHIN 15m CHANGES restart
  WHEN "an NVIDIA Xid error left the GPU unusable"
  RUN  systemctl reboot

SKILL nvidia-driver WHEN "installing or checking the NVIDIA driver on Ubuntu" <<EOF
  - apt-get install -y ubuntu-drivers-common, then ubuntu-drivers install --gpgpu: the server
    driver branch, for compute. It does not bring nvidia-smi: install
    nvidia-utils-<branch>-server for the same branch (dpkg -l | grep nvidia-driver names it).
  - The driver loads only after a reboot; the action reboots after this step.
  - Never mix the distribution's driver with NVIDIA's .run installer or CUDA repository driver:
    two drivers on one box break both. vLLM's wheels bring their own CUDA runtime; the box
    needs only the driver.
  - Secure Boot can refuse the module: "Required key not available" in dmesg. Only the
    person can turn Secure Boot off or enrol the key.
EOF

SKILL nvidia-xid WHEN "what NVIDIA Xid errors mean, and which ones software cannot fix" <<EOF
  The kernel line `NVRM: Xid (PCI:0000:3b:00): 79, ...` carries the Xid after the address.

  | Xid        | usual cause                          | software fix                    |
  |------------|--------------------------------------|---------------------------------|
  | 13, 31, 43 | the application                      | restart vllm                    |
  | 45         | cleanup after a killed process       | none needed                     |
  | 48, 94, 95 | uncorrectable ECC memory error       | reboot; again: replace the GPU  |
  | 63, 64     | page retirement or row remapping     | reboot to apply                 |
  | 74         | NVLink error                         | reboot; again: hardware         |
  | 79         | the GPU fell off the bus             | reboot; again: hardware         |

  After a reboot: nvidia-smi -q -d ECC,PAGE_RETIREMENT,ROW_REMAPPER.
  Hardware errors go to the person, with the Xid lines: only the provider can replace a GPU.
EOF

# ── Install ────────────────────────────────────────────

FACT vllm  BOOL  /opt/vllm/bin/vllm --version

GOAL installed  "vLLM is installed"  AFTER driver  vllm

ACTION install "Install vLLM" FOR installed WITHIN 1h CHANGES version, config, network
  WHEN "vLLM is missing"
  DO <<EOF
    Install the latest vLLM release with uv into /opt/vllm.
    Run `vllm serve $model` on port 8000 as the systemd service vllm. Access: $access.
    The service reads VLLM_API_KEY and HF_TOKEN from /etc/vllm/env, mode 600.
  EOF

SKILL vllm-install WHEN "installing vLLM, its systemd unit and its environment file" <<EOF
  - uv venv /opt/vllm --python 3.12, then uv pip install --python /opt/vllm/bin/python vllm
    --torch-backend=auto: uv picks the PyTorch build for the installed driver.
  - /etc/vllm/env, mode 600, owner root: VLLM_API_KEY=... only when access is private,
    HF_TOKEN=... only for a gated model. Write it from the environment with printf, never
    with the values on a command line. The unit reads it with EnvironmentFile=.
  - The first start downloads the model into /root/.cache/huggingface/hub: tens of GB, and
    minutes to an hour. A 401 or "gated repo" error is a missing or wrong HF_TOKEN, or a
    token whose owner has not accepted the model's license: only the person can.
  - Pin nothing by hand in the venv; a vLLM upgrade is a new venv, and the ASK rule applies.
EOF

# ── Serving ────────────────────────────────────────────

FACT up      BOOL  curl -sf localhost:8000/health
FACT served  TEXT  "the id of the first model that localhost:8000/v1/models lists, \
              sending VLLM_API_KEY as a bearer token when it is set"

GOAL running  "vLLM answers"       AFTER installed  up
GOAL serving  "vLLM serves $model"  AFTER running, box:room  served == model

ACTION restart "Restart vLLM" FOR running, gpu-healthy, quiet WITHIN 15m CHANGES restart
  WHEN "the engine hung or crashed, or an application Xid error (13, 31, 43) hit a healthy GPU"
  RUN  systemctl restart vllm

ACTION serve "Switch to the requested model" FOR serving WITHIN 1h CHANGES config, restart
  WHEN "the server runs, but serves a model other than $model"
  DO   "change the model in the vllm unit to $model, keeping the other flags \
        that still fit it, and restart vllm"

SKILL vllm-serving WHEN "vllm serve flags, memory and concurrency settings, and its metrics" <<EOF
      /opt/vllm/bin/vllm serve $model --host <127.0.0.1 or the private address> --port 8000 \
        --gpu-memory-utilization 0.90 --max-model-len <fits the KV cache> --max-num-seqs <n>

  VLLM_API_KEY turns on bearer auth for /v1, /v2 and /inference. /health and /metrics
  stay open: keep port 8000 off the internet. private: listen on the box's private address
  only, never 0.0.0.0; ufw allows 22/tcp first, then 8000/tcp from the private network only.
  Startup logs print the KV cache size and the concurrency for --max-model-len.
  Out of memory at startup: lower --max-model-len first, then --gpu-memory-utilization.
  A start takes minutes: the weights load and CUDA graphs compile. /health fails until then;
  that is progress, not a hang.
  Another process on the GPU (nvidia-smi lists it) takes memory vLLM counted on: vLLM fails
  at start with too little memory for the KV cache.
EOF

# ── Load ───────────────────────────────────────────────

FACT waiting    NUMBER    "the sum of vllm:num_requests_waiting in localhost:8000/metrics"
FACT kv         NUMBER %  "vllm:kv_cache_usage_perc in localhost:8000/metrics, times 100"
FACT preempted  NUMBER    "the sum of vllm:num_preemptions_total in localhost:8000/metrics"

GOAL keeping-up  "vLLM keeps up with its requests" \
                 AFTER running  EVERY 5m  waiting < 20 AND DELTA(preempted) < 50

ACTION lower-concurrency "Serve fewer requests at once" FOR keeping-up WITHIN 15m CHANGES config, restart
  WHEN "the engine answers, but preempts requests for long or fills its KV cache"
  DO   "lower --max-num-seqs in the vllm unit by a quarter, restart vllm, and say the new value"

SKILL vllm-load WHEN "a growing queue, preemptions, or a full KV cache" <<EOF
  | metric                      | means                                    |
  |-----------------------------|------------------------------------------|
  | vllm:num_requests_running   | requests in the current batch            |
  | vllm:num_requests_waiting   | requests queued for a slot               |
  | vllm:kv_cache_usage_perc    | KV cache in use; 1 is full               |
  | vllm:num_preemptions_total  | requests evicted and recomputed          |

  A queue with an empty KV cache: raise --max-num-seqs. Preemptions with a full one: lower it.
  A queue with a full KV cache and few preemptions is a box at its limit: more traffic than
  one GPU serves. Say so; only the person adds a GPU.
  Every change of a flag is a restart, and a restart drops the requests in flight.
EOF

# ── Disk ───────────────────────────────────────────────

# Room on the filesystems is the box weave's goal; this says what other models take.
FACT others_gb  NUMBER GB  "the size of the model directories in /root/.cache/huggingface/hub other than $model's"

GOAL old-models  "other models leave the disk room" \
                 AFTER installed  EVERY 10m  box:disk < 85% OR others_gb < 1GB

ACTION free-disk "Delete the other models" FOR old-models WITHIN 15m CHANGES data
  WHEN "models other than $model, not $model itself, take room on a full disk"
  DO   "free space in /root/.cache/huggingface by removing models other than $model"

SKILL hf-cache WHEN "the Hugging Face model cache and freeing disk" <<EOF
  - Each model is one directory in /root/.cache/huggingface/hub, named models--<org>--<name>:
    Qwen/Qwen3-8B is models--Qwen--Qwen3-8B. Delete whole directories of other models only.
  - Never delete the directory of $model: vLLM reads it at every start and would download
    it again.
  - Half-finished downloads end in .incomplete under blobs; they are safe to delete when
    no download runs.
EOF

# ── Updates ────────────────────────────────────────────

# The box weave installs security updates; they skip the driver and CUDA here, since a new
# driver needs a reboot and the person.
FACT gpu_held  BOOL  grep -q nvidia /etc/apt/apt.conf.d/51subweave-gpu

GOAL held  "security updates leave the driver and CUDA alone"  AFTER installed  EVERY 1d  gpu_held

ACTION hold "Hold the driver back from updates" FOR held WITHIN 2m CHANGES config
  WHEN "unattended upgrades may update the NVIDIA driver or CUDA"
  ADD <<EOF /etc/apt/apt.conf.d/51subweave-gpu
    Unattended-Upgrade::Package-Blacklist { "nvidia-"; "libnvidia-"; "cuda-"; };
  EOF

# ── Logs ───────────────────────────────────────────────

FACT logs  LINES  "new WARNING, ERROR and Traceback lines of the vllm service's journal"

GOAL quiet  "the logs show no trouble"  AFTER running  EVERY 10m \
     "the lines in `logs` and `xid` show nothing that needs action"

# ── Anything else ──────────────────────────────────────

ACTION fix "Fix the failing goal" WITHIN 30m CHANGES restart, config, version, data, network
  WHEN "no other action fits, or the fitting ones already failed"
  DO   "make the failing goal hold again without deleting the files of $model, changing the driver, \
        or stopping vllm for longer than a restart"
