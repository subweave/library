# A Paper Minecraft server for a club, a class or a group of friends.
#   subweave run minecraft "survival server for 20 friends, whitelist only, back up every 6 hours"

ABOUT  "Paper Minecraft server with RCON, world backups and Paper build updates"
FROM   ubuntu:24.04
NEEDS  4 CPU, 8 GB RAM, 50 GB DISK

# ── What a request chooses ─────────────────────────────

ARG version=26.2     SHOULD "a Minecraft version that Paper builds for, like 26.2"
ARG join=whitelist   SHOULD
    whitelist  "only players on the whitelist"
    open       "anyone with the address"
ARG backups=6h       SHOULD "how often to back up the world, a duration like 6h"
ARG max_players=20   MAY    "the most players online at once, a number like 20"
ARG mode=survival    MAY
    survival   "survival mode"
    creative   "creative mode"
ARG keep=14          MAY    "how many world backups to keep on the box, a number like 14"
ARG updates=auto     MAY
    auto       "install new Paper builds for $version, which keep the Minecraft version, while nobody plays"
    off        "keep the installed Paper build"

# mcrcon reads MCRCON_PASS
SECRET MCRCON_PASS "the RCON password"

# ── Rules ──────────────────────────────────────────────

NEVER "op a player, or change the whitelist or bans"
NEVER "delete or reset a world"
NEVER "open the RCON port 25575 to the internet"
NEVER IF keep < 1 BECAUSE "the weave keeps at least one world backup"
ASK   BEFORE restore BECAUSE "a restore replaces the live world"
ASK   "before installing Paper for a Minecraft version other than $version: a world cannot go back to an older one"

# ── Install ────────────────────────────────────────────

FACT java   BOOL "exits 0 when java runs and its major release is 25 or newer"
FACT paper  BOOL test -f /opt/minecraft/paper.jar

GOAL runtime    "Java 25 or newer is installed"  java
GOAL installed  "Paper is installed"  AFTER runtime  paper

ACTION install-java "Install Java" FOR runtime WITHIN 10m CHANGES version
  WHEN "Java 25 is missing"
  RUN  apt-get install -y openjdk-25-jre-headless

ACTION install "Install Paper" FOR installed WITHIN 20m CHANGES version, config, network
  WHEN "Paper is missing"
  DO <<EOF
    Create the user minecraft and /opt/minecraft. Keep any worlds already there.
    Download the latest Paper $version build from the Fill API, check its sha256,
    and write its build id to /opt/minecraft/build. Accept the EULA.
    server.properties: max-players $max_players, gamemode $mode,
    whitelist on only when join is 'whitelist' (it is '$join'),
    RCON on port 25575 with the password in MCRCON_PASS.
    Install mcrcon into /usr/local/bin.
    Run the server as the systemd service minecraft, with Paper's recommended JVM flags.
  EOF

SKILL paper-server WHEN "Paper downloads, JVM flags, server.properties, the firewall and RCON" <<EOF
      api=https://fill.papermc.io/v3/projects/paper/versions/$version
      curl -s $api/builds/latest | jq '.id, .downloads."server:default"'
      curl -s $api | jq -r '.version.java.version.minimum, .version.java.flags.recommended[]'

  The second command gives the minimum Java release and Paper's recommended JVM flags.
  Add -Xms and -Xmx at about 70% of the box's memory, both the same. Never give the JVM all of
  it: the kernel's out-of-memory killer then ends the server mid-save.

  | server.properties               | value                          |
  |---------------------------------|--------------------------------|
  | max-players                     | $max_players                   |
  | gamemode                        | $mode                          |
  | white-list, enforce-whitelist   | true for whitelist             |
  | enable-rcon / rcon.port         | true / 25575                   |
  | rcon.password                   | from MCRCON_PASS; never echo   |

  RCON listens on every address and sends the password in clear: allow 22/tcp and
  25565/tcp in ufw, and nothing for 25575.
  mcrcon is not in Ubuntu: install the release binary from github.com/Tiiffi/mcrcon.
  It reads MCRCON_PASS, MCRCON_HOST and MCRCON_PORT; -c turns off colour codes.
  Accept the EULA with eula=true in /opt/minecraft/eula.txt.
  The unit runs as the user minecraft in /opt/minecraft; a stop sends the server's own
  "stop" over RCON or SIGTERM and waits, so the worlds are saved.
EOF

# ── Running ────────────────────────────────────────────

FACT up       BOOL    systemctl is-active -q minecraft
FACT rcon     BOOL    mcrcon -c list > /dev/null
FACT players  NUMBER  "the number of players online, from mcrcon -c list"
FACT tps      NUMBER  "the 1-minute ticks per second that mcrcon -c tps prints first"

GOAL running  "the server runs and answers commands" \
              AFTER installed             up AND rcon
GOAL smooth   "the server runs at full speed while people play" \
              AFTER running    EVERY 5m   players == 0 OR tps >= 18

ACTION restart "Restart the server" FOR running, smooth WITHIN 5m CHANGES restart
  WHEN "the server crashed or stays slow on a build that ran well before, and its worlds load"
  RUN  mcrcon -c "say Restarting in 30 seconds" || true
  RUN  sleep 30
  RUN  systemctl restart minecraft

# Stopping saves the worlds; nobody plays, so nobody is kicked.
DRILL stop "Stop the server" BREAK systemctl stop minecraft \
      EXPECT running FAILS WITHIN 3m HOLDS WITHIN 10m EVERY 30d IF players == 0
  RESTORE systemctl start minecraft

SKILL lag WHEN "low TPS, lag with players online, or the server running out of memory" <<EOF
  20 ticks per second is full speed; under 18 players feel it.
  - Paper ships the spark profiler: mcrcon -c "spark tps", then
    mcrcon -c "spark profiler start --timeout 60" names the slow plugin, entity type or chunk.
  - Usual causes: new chunks being generated as players explore, large farms with many
    entities or hoppers, redstone clocks, too large view-distance or simulation-distance.
  - A restart helps only a leak; a farm makes the lag again within minutes. Lowering
    simulation-distance in server.properties (needs a restart) helps without touching worlds;
    entity limits live in config/paper-world-defaults.yml.
  - Garbage collection pauses: -Xmx too small for the players, or too large for the box.
  - Never kill entities or delete chunks to make it faster: that changes the worlds.
  - Tell the person which farm or area, with coordinates, when spark or the logs name one.
EOF

# ── Backups ────────────────────────────────────────────

GOAL saved  "a world backup was made in the last $backups"  AFTER running, box:room  SINCE(backup) < backups

ACTION backup "Back up the world" FOR saved WITHIN 30m CHANGES data
  WHEN "the last world backup is older than $backups"
  RUN <<EOF
    mkdir -p /var/backups/minecraft
    mcrcon -c save-off "save-all flush"
    trap 'mcrcon -c save-on' EXIT
    tar -czf /var/backups/minecraft/world-$(date +%Y%m%d-%H%M).tgz \
      -C /opt/minecraft world world_nether world_the_end
  EOF
  RUN  ls -1t /var/backups/minecraft/world-*.tgz | tail -n +$((keep + 1)) | xargs -r rm

ACTION restore "Restore the newest backup" FOR running, quiet WITHIN 15m CHANGES data, restart
  WHEN "a corrupt world stops the server from starting"
  RUN <<EOF
    systemctl stop minecraft
    t=$(date +%Y%m%d%H%M%S)
    for w in world world_nether world_the_end; do
      if [ -e /opt/minecraft/$w ]; then mv -T /opt/minecraft/$w /opt/minecraft/$w.before-restore-$t; fi
    done
    tar -xzf "$(ls -1t /var/backups/minecraft/world-*.tgz | head -1)" -C /opt/minecraft
    chown -R minecraft: /opt/minecraft/world /opt/minecraft/world_nether /opt/minecraft/world_the_end
    systemctl start minecraft
  EOF

GOAL drilled  "a backup passed a test restore in the last 30 days" \
              AFTER saved  EVERY 1d  SINCE(rehearse) < 30d

ACTION rehearse "Test a restore" FOR drilled WITHIN 30m CHANGES nothing
  WHEN "no world backup was test-restored in the last 30 days"
  RUN <<EOF
    d=$(mktemp -d /var/tmp/drill.XXXXXX)
    trap 'rm -rf "$d"' EXIT
    tar -xzf "$(ls -1t /var/backups/minecraft/world-*.tgz | head -1)" -C "$d"
    for w in world world_nether world_the_end; do
      test -s "$d/$w/level.dat"
      find "$d/$w" -name '*.mca' -size +0 | grep -q .
    done
  EOF

SKILL worlds WHEN "world backups, restores and corrupt worlds" <<EOF
  - A world copied while the server writes it is torn. save-off, then "save-all flush", copy,
    then save-on: the backup action does exactly that, and save-on runs even when tar fails.
  - Backups live in /var/backups/minecraft, world-<date>.tgz, the newest $keep kept.
  - restore moves the broken worlds to <world>.before-restore-<time>; they stay on disk for
    the person. Never delete them.
  - "Failed to load level", "Couldn't load chunk" or region file errors in the log name the
    broken world. One bad chunk does not need a restore: the server regenerates or skips it.
  - Players lose everything built since the newest backup. Say so when asking.
EOF

# ── Disk ───────────────────────────────────────────────

# Room on the filesystems is the box weave's goal; this says what the server's logs take.
FACT logs_gb  NUMBER GB  "the size of /opt/minecraft/logs"

GOAL old-logs  "old server logs leave the disk room" \
               AFTER installed  EVERY 10m  box:disk < 85% OR logs_gb < 1GB

ACTION trim "Delete old logs" FOR old-logs WITHIN 10m CHANGES data
  WHEN "old server logs, not worlds or backups, take room on a full disk"
  DO   "delete compressed server logs in /opt/minecraft/logs older than 14 days"

# ── Paper updates ──────────────────────────────────────

FACT build   TEXT  cat /opt/minecraft/build
FACT skip    TEXT  cat /opt/minecraft/skip-build
FACT latest  TEXT  curl -s https://fill.papermc.io/v3/projects/paper/versions/$version/builds/latest \
               | jq -r .id

GOAL current  "the server runs the newest Paper build"  AFTER running  EVERY 1h \
     build == latest OR latest == skip OR players > 0   IF updates == 'auto'

# Its WITHIN is how long rollback, its UNDO, watches the server after it.
ACTION update "Update Paper" FOR current WITHIN 2h CHANGES version, restart UNDO rollback
  WHEN "a newer Paper build for $version exists, and nobody plays"
  DO   "install the newest Paper $version build, keeping the running jar and its build id \
        as .previous, and restart the server"

ACTION rollback "Go back to the previous build" WITHIN 5m CHANGES version, restart
  WHEN "an update failed, or a goal that held before it fails since"
  RUN <<EOF
    cd /opt/minecraft
    if [ -f paper.jar.previous ]; then
      cp build skip-build && mv paper.jar.previous paper.jar && mv build.previous build
    fi
    systemctl restart minecraft
  EOF

SKILL paper-update WHEN "installing a newer Paper build for the same Minecraft version" <<EOF
  A build changes Paper, never the Minecraft version, so the worlds stay readable.

  ```recipe
  cd /opt/minecraft
  curl -fsS https://fill.papermc.io/v3/projects/paper/versions/$version/builds/latest > /tmp/paper.json
  curl -fsSL -o paper.jar.new "$(jq -r '.downloads."server:default".url' /tmp/paper.json)"
  echo "$(jq -r '.downloads."server:default".checksums.sha256' /tmp/paper.json)  paper.jar.new" | sha256sum -c -
  cp paper.jar paper.jar.previous && cp build build.previous
  mv paper.jar.new paper.jar && jq -r .id /tmp/paper.json > build
  systemctl restart minecraft
  ```

  A checksum that fails: delete paper.jar.new and stop. rollback writes the bad build to
  skip-build, so current holds until a newer one comes.
EOF

# ── Logs ───────────────────────────────────────────────

# WARN and ERROR lines only: never chat, which players write.
FACT logs  LINES  tail -n 0 -F /opt/minecraft/logs/latest.log \
             | grep --line-buffered -E '/(WARN|ERROR)\]: '

GOAL quiet  "the logs show no trouble"  AFTER running  EVERY 15m \
     "the lines in `logs` show nothing that needs action"

# ── Anything else ──────────────────────────────────────

ACTION fix "Fix the failing goal" WITHIN 30m CHANGES restart, config, version, data, network
  WHEN "no other action fits, or the fitting ones already failed"
  DO   "make the failing goal hold again without touching the worlds"
